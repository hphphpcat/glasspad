{
  "name": "glasspad",
  "version": "1.0.15",
  "private": true,
  "description": "GlassPad：React + Electron + WebSocket 实时协同提词",
  "main": "electron/main.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "web": "vite",
    "dev": "concurrently -k -n server,web \"npm run server\" \"npm run web\"",
    "electron": "electron electron/main.js",
    "dev:all": "concurrently -k -n server,web,electron \"npm run server\" \"npm run web\" \"npm run electron\"",
    "build": "vite build",
    "dist": "npm run build && electron-builder --mac dmg",
    "dist:dir": "npm run build && electron-builder --mac dir",
    "dist:win": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "monaco-editor": "^0.57.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.glasspad.app",
    "productName": "GlassPad",
    "afterPack": "scripts/afterPack.js",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "build/blackhole-setup",
        "to": "blackhole-setup"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        "dmg"
      ],
      "identity": null
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false,
      "sign": null
    },
    "portable": {
      "artifactName": "GlassPad-${version}-portable.exe"
    },
    "dmg": {
      "title": "GlassPad",
      "icon": "build/icon.icns",
      "contents": [
        {
          "x": 130,
          "y": 180
        },
        {
          "x": 410,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 270,
          "y": 340,
          "type": "file",
          "path": "build/首次打开防损坏修复.command"
        }
      ]
    }
  }
}
