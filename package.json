{
  "name": "codex-clone",
  "version": "1.0.0",
  "private": true,
  "description": "Codex Interview 1:1 复刻：React + Electron + WebSocket 实时协同",
  "main": "electron/main.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "web": "vite",
    "dev": "concurrently -k -n server,web \"npm run server\" \"npm run web\"",
    "electron": "electron electron/main.js",
    "dev:all": "concurrently -k -n server,web,electron \"npm run server\" \"npm run web\" \"npm run electron\"",
    "build": "vite build",
    "dist": "electron-builder --mac dmg",
    "dist:dir": "electron-builder --mac dir",
    "dist:win": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.codex.clone",
    "productName": "Codex",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": ["dmg"],
      "identity": null
    },
    "win": {
      "target": ["portable"],
      "icon": null,
      "signAndEditExecutable": false,
      "sign": null
    },
    "portable": {
      "artifactName": "Codex-${version}-portable.exe"
    },
    "dmg": {
      "title": "Codex",
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    }
  }
}
